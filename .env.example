# Public configuration (safe to include in browser bundles)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Server credentials: never use NEXT_PUBLIC_ for these.
TELECRM_API_KEY=
RECAPTCHA_SECRET_KEY=
SANITY_API_TOKEN=
SANITY_API_WRITE_TOKEN=
REVALIDATE_SECRET=

# Comma-separated reCAPTCHA hostnames. Add staging/local hosts only when needed.
RECAPTCHA_ALLOWED_HOSTNAMES=www.dholerainsider.com,dholerainsider.com

# Optional: only set to a header that your ingress proxy always overwrites.
# Without this setting, only the process-wide 120 requests/minute guard applies.
FORM_TRUSTED_IP_HEADER=
